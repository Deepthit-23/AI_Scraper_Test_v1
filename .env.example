# Copy this file to .env and fill in your real keys.

# Groq — LLM inference (classification, attribute extraction).
# Free tier: 100,000 tokens/day. No credit card needed.
# Get at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here

# ScraperAPI — fallback scraping tier for Cloudflare / JS-rendered manufacturer sites.
# Used ONLY when the direct URL template and DDG search both fail (Stage 3).
# Free tier: 1,000 credits/month recurring + 5,000 credits on 7-day trial.
# 1 request = 1 credit. No credit card required for the trial.
# Get at: https://www.scraperapi.com/
SCRAPERAPI_KEY=your-scraperapi-key-here
